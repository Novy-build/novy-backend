# Defaults to production when unset; development and test expose the API documentation.
NOVY_ENVIRONMENT=development

# MongoDB Connection string 
MONGODB_CONNECTION_STRING="mongodb+srv://<db_username>:<db_password>@novy.jc2krbq.mongodb.net/"
NEXT_PUBLIC_SUPABASE_URL="https://<string>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<string>"

# Comma-separated browser origins allowed for cookie-authenticated mutations.
# Required in production; development/test default to the local Vite origins.
NOVY_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Separate 32-byte keys, each canonical padded URL-safe Base64.
# Generate with a secret manager; never commit real values.
NOVY_SESSION_ENCRYPTION_KEY="<base64url-32-bytes>"
NOVY_SESSION_LOOKUP_KEY="<base64url-32-bytes>"

